{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "Debug STM32F411RE",

            "cwd": "${workspaceFolder}",

            "chip": "STM32F411RETx",

            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": true
            },

            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "${workspaceFolder}/target/thumbv7em-none-eabihf/debug/f411_blinky"
                }
            ]
        }
    ]
}